{
  "name": "remotion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "dev:echoes": "vite --host 0.0.0.0 --port 5174 --open /src/features/movement-echoes/demo/index.html",
    "build:echoes": "tsc -b && vite build --config vite.echoes.config.ts",
    "api:dev": "tsx server/main.ts",
    "api:demo": "DEMO_MODE=true tsx server/main.ts",
    "api:check": "tsc -p server/tsconfig.json",
    "api:token": "tsx server/token.ts",
    "build:clinician": "tsc -b && vite build --config vite.clinician.config.ts",
    "api:demo:seed": "DEMO_MODE=true SEED_DEMO=true tsx server/main.ts",
    "api:provision": "tsx server/provision.ts",
    "dev:voice": "vite --config src/features/voice-coach/harness/vite.config.ts",
    "build:voice": "tsc -b && vite build --config src/features/voice-coach/harness/vite.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@electric-sql/pglite": "^0.5.10",
    "@elevenlabs/react": "^1.18.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@google/genai": "^2.30.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.183.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
