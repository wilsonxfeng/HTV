# Copy to .env.server. Never add these values to any VITE_ variable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=verify-full
# For private certificate authorities, use the trusted CA downloaded from TigerData.
DATABASE_CA_FILE=
DATABASE_TLS_MODE=verify-full
# Optional local clinician preview of an existing synthetic-only fictional patient.
LOCAL_DEMO_PATIENT_ID=
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
S3_BUCKET=remotion-recordings
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
APP_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001
API_HOST=127.0.0.1
API_PORT=3001
